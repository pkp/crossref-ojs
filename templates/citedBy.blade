<section class="item crossref-cited-by" data-vue-root>
    <h2 class="label">{{ __('plugins.generic.crossref.citedBy') }}</h2>
    <div class="CrossrefCitedBy__label">
        <span>{{ __('plugins.generic.crossref.citedBy.thisArticleHasBeenCited') }}</span>
        <span>
            <strong>
                <crossref-cited-by-count></crossref-cited-by-count>
            </strong>
        </span>
        <span>
            {!! __('plugins.generic.crossref.citedBy.timesAccordingTo') !!}
        </span>
    </div>
    <pkp-button class="CrossrefCitedBy__viewCitations"
        @action='({pkp}) => pkp.registry.getPiniaStore("crossrefCitedBy").openCitedByModal()'>
        {{ __('plugins.generic.crossref.citedBy.viewCitingArticles') }}
    </pkp-button>
</section>
